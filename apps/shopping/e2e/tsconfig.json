{
  // Type-check scope for the Playwright layer only. The app's main tsconfig includes `src`
  // (the runtime + vitest surface), deliberately NOT `e2e`, so the E2E spec and the Playwright
  // config are checked here instead — this keeps Playwright's `test`/`expect` and the vitest
  // globals in separate programs. Run with: `tsc --noEmit -p e2e/tsconfig.json`.
  "extends": "@vikings/typescript-config/react-library.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["**/*.ts", "../playwright.config.ts"]
}
