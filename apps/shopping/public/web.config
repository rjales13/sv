<?xml version="1.0" encoding="utf-8"?>
<!-- IIS on Azure App Service (Windows): serve index.html for client-side routes such as /embed. -->
<configuration>
  <system.webServer>
    <!-- IIS answers 404.3 for an extension it has no MIME type for, even when the file exists,
         and .woff2 is not in its default list: every Open Sans font 404'd without this. Each
         <remove> comes first because some IIS versions already map .woff, and a duplicate
         mapping is a 500.19 for the whole site. -->
    <staticContent>
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
    <!-- Dynamics 365 renders the app in an iframe (VCX-10478), so the browser must be told which
         parents may frame it. 'self' keeps the mock D365 shell at / (which frames /embed) working.
         The D365 origins are wildcards, agreed for now: IIS cannot read env vars here, so exact
         per-environment origins need a build step. Until then any D365 org can frame the app.
         The exact origins per environment are listed in docs/adr/0018.
         Only frame-ancestors is set; a default-src/script-src would also govern the bundle.
         The <remove> comes first for the same 500.19 reason as the font mappings above.
         X-Frame-Options is stripped, not rewritten: browsers apply it alongside CSP, so an
         inherited DENY/SAMEORIGIN would still block D365, and ALLOW-FROM is ignored today. -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Frame-Options" />
        <remove name="Content-Security-Policy" />
        <add name="Content-Security-Policy" value="frame-ancestors 'self' https://*.crm.dynamics.com https://*.powerapps.com" />
        <!-- VCX-10480: the launch URL carries CRM record ids. Cross-origin, browsers then send only
             the origin as the Referer, never the query string. -->
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>
    <rewrite>
      <rules>
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <!-- /api is the Integration Layer's virtual application (ADR-0017), never a SPA route. -->
            <add input="{REQUEST_URI}" pattern="^/api(/|\?|$)" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
